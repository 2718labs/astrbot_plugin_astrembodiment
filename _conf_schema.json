{
  "runtime_envelope": {
    "description": "运行资源档位",
    "hint": "只影响运行时资源包络，不改变身份公式或行为。",
    "type": "string",
    "options": [
      "auto",
      "reference-2c2g-v1",
      "compat-1c1g-v1"
    ],
    "labels": [
      "自动",
      "参考资源档位（2 核 2G）",
      "兼容资源档位（1 核 1G）"
    ],
    "default": "auto"
  },
  "native_data_dir": {
    "description": "原生核心数据目录",
    "hint": "可填写绝对路径；留空时使用 AstrBot 为插件分配的数据目录。插件会在该目录内创建 astrembodiment.sqlite3。",
    "type": "string",
    "default": ""
  },
  "embodiment_clock_enabled": {
    "description": "启用角色生理时钟",
    "hint": "本地确定性时钟，不调用模型、不发送消息、不消耗 Token。",
    "type": "bool",
    "default": true
  },
  "persona_timezone": {
    "description": "角色独立时区",
    "type": "string",
    "default": "America/Los_Angeles"
  },
  "persona_sleep": {
    "description": "角色睡眠",
    "type": "object",
    "items": {
      "mode": {
        "description": "睡眠模式",
        "type": "string",
        "options": [
          "auto",
          "fixed"
        ],
        "default": "auto"
      },
      "sleep": {
        "description": "固定模式入睡时间",
        "type": "string",
        "default": "01:30"
      },
      "wake": {
        "description": "固定模式醒来时间",
        "type": "string",
        "default": "09:30"
      }
    },
    "default": {}
  },
  "semantic_appraisal_token_daily_max": {
    "description": "语义情感评估每日预算",
    "hint": "按角色与原生 UTC 日独立结算；默认 16384，设为 0 可完全关闭语义评估，最大 1000000。未知用量按本次完整预留量收费。",
    "type": "int",
    "default": 16384,
    "min": 0,
    "max": 1000000
  },
  "model_settings": {
    "description": "模型辅助设置",
    "type": "object",
    "items": {
      "assistant_provider_id": {
        "description": "辅助模型 Provider",
        "hint": "统一用于创世与语义评估；留空时兼容旧语义 Provider 配置，均为空时使用当前会话模型。",
        "type": "string",
        "_special": "select_provider",
        "default": ""
      },
      "semantic_estimator_provider_id": {
        "description": "语义情感评估 Provider",
        "hint": "旧版兼容字段；辅助模型 Provider 优先。每个授权入站最多调用一次。",
        "type": "string",
        "_special": "select_provider",
        "default": ""
      }
    },
    "default": {}
  },
  "seed_code": {
    "description": "SeedCode（身份种子）",
    "hint": "系统生成，仅用于查看；生成后自动保存，重载插件后仍可见。",
    "type": "text",
    "default": "",
    "readonly": true
  }
}
